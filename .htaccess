RewriteEngine On
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType image/webp .webp
</IfModule>

# El HTML se revisa siempre: así cada subida se ve enseguida.
# Lo de /assets/ lleva un hash en el nombre y puede guardarse un año.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+contacto\.html[\s?] [NC]
RewriteRule ^contacto\.html$ /contacto/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+faq\.html[\s?] [NC]
RewriteRule ^faq\.html$ /faq/ [R=301,L]

RewriteRule ^api/contacto/?$ api/contacto.php [L]
RewriteRule ^api/ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]
